#!/bin/bash
#SBATCH -A f202500010hpcvlabuminhoa
#SBATCH -p normal-arm
#SBATCH -J md
#SBATCH --nodes=1
#SBATCH --ntasks=1
#SBATCH --cpus-per-task=48
#SBATCH --time=00:20:00
#SBATCH --output=/projects/F202500010HPCVLABUMINHO/2026-2027cp/%u/logs/%x-%j.log

EXECUTABLE="$(mktemp -d)/a.out"
CURDATE=$(date +"%Y-%m-%d--%H-%M")
RESULTS="results/$CURDATE"

mkdir -p $RESULTS

ml load gcc/15.2.0

gcc -O3 src/MD.cpp -lm -o $EXECUTABLE 

perf record $EXECUTABLE
perf report -n --stdio > $RESULTS/perf_report.txt
