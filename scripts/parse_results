#!/bin/bash
set -euo pipefail

if [ $# -ne 1 ]; then
  echo "requires one argument" 1>&2
  exit 1
fi

echo "threads,seconds,cpi,instructions,accelerations_fraction,result"

paste -d, \
  <(./parse_results_src/column1 $1) \
  <(./parse_results_src/time_elapsed $1) \
  <(./parse_results_src/cpi $1) \
  <(./parse_results_src/instructions $1 | tr -d ',') \
  <(./parse_results_src/fractions $1) \
  <(./parse_results_src/result $1)
